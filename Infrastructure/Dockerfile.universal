# --- STAGE 1: Build & Publish ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Копируем файлы проектов для восстановления зависимостей
COPY ["src/Calendar/Calendar_Service.csproj", "src/Calendar/"]
COPY ["src/Contracts/Calendar.Contracts.csproj", "src/Contracts/"]
COPY ["src/NotificationService/NotificationService.csproj", "src/NotificationService/"]

# Восстанавливаем зависимости
RUN dotnet restore "src/Calendar/Calendar_Service.csproj"
RUN dotnet restore "src/NotificationService/NotificationService.csproj"

# Копируем весь исходный код
COPY . .

ARG PROJECT_NAME
ARG PROJECT_FILE
WORKDIR "/src/src/$PROJECT_NAME"

# Собираем и публикуем проект
RUN dotnet publish "$PROJECT_FILE" -c Release -o /app/publish /p:UseAppHost=false

# Переименовываем DLL и конфигурационные файлы для универсального entrypoint
RUN mv "/app/publish/$(basename $PROJECT_FILE .csproj).dll" "/app/publish/App.dll" && \
    mv "/app/publish/$(basename $PROJECT_FILE .csproj).runtimeconfig.json" "/app/publish/App.runtimeconfig.json" && \
    mv "/app/publish/$(basename $PROJECT_FILE .csproj).deps.json" "/app/publish/App.deps.json"

# --- STAGE 2: Runtime (Chiseled) ---
# Используем Chiseled образ для максимальной безопасности (нет shell, нет root по умолчанию)
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled AS final
WORKDIR /app

# Копируем артефакты
COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "App.dll"]