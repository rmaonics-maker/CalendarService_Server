# --- STAGE 1: Build & Publish ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Копируем файлы проектов для восстановления зависимостей
COPY ["src/Calendar/Calendar_Service.csproj", "src/Calendar/"]
COPY ["src/Contracts/Calendar.Contracts.csproj", "src/Contracts/"]

# Восстанавливаем зависимости
RUN dotnet restore "src/Calendar/Calendar_Service.csproj"

# Копируем весь исходный код
COPY . .

ARG PROJECT_NAME
WORKDIR "/src/src/$PROJECT_NAME"

# Собираем и публикуем проект
RUN dotnet publish "Calendar_Service.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Переименовываем DLL для универсального entrypoint
RUN mv "/app/publish/Calendar_Service.dll" "/app/publish/App.dll"

# --- STAGE 3: Runtime (Chiseled) ---
# Используем Chiseled образ для максимальной безопасности (нет shell, нет root по умолчанию)
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled AS final
WORKDIR /app

# Копируем артефакты
COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "App.dll"]